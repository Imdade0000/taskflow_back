// Schéma Prisma avec gestion complète du cycle de vie des données

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  firstname     String
  lastname      String
  username      String         @unique
  email         String         @unique
  phone         String?        @unique
  password      String
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  creator User?          @relation( "creator", fields: [createdBy], references: [id])
  createdUsers      User[]     @relation("creator")
  isActive      Boolean        @default(true)
  deletedAt     DateTime? 

  refreshTokens           RefreshToken[]
  twoFactorEnabled        Boolean        @default(true)
  twoFactorCode           String?
  twoFactorExpiry         DateTime?     
  
  departementId String?
  department   Department? @relation(fields: [departementId], references: [id])
  
  roleId       String
  role         Role?      @relation(fields: [roleId], references: [id])
  clientProfile ClientProfile?      
  ProjectMembers ProjectMember[]
  comments      Comment[]
  notifications Notification[]
  documents     Document[]
  defaultTaskStatuses DefaultTaskStatus[]
  reviews TaskReview[]
  

}

model TaskReview {
  id          String   @id @default(uuid())
  reviewerId   String 
  reviewer     User     @relation( fields: [reviewerId], references: [id])
  rating      Int
  comment     String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  TaskId     String
  task        Task     @relation(fields: [TaskId], references: [id])
}

model Department {
  id          String   @id @default(uuid())
  departmentId String?
  department Department? @relation("AffiliatedDepartments", fields: [departmentId], references: [id])
  subDepartments Department[] @relation("AffiliatedDepartments")
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  users       User[]
}

model RefreshToken {
  id                      String         @id @default(uuid()) @db.VarChar(36)
  token                   String         @unique
  expiresAt               DateTime
  userId                  String         @db.VarChar(36)
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime       @default(now())
}

model ClientProfile {
  id           String   @id @default(uuid())
  clientTicket String   @unique
  company      String?
  industry     String?
  address      String?
  website      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? 
  
  
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique 
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?    
  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id          String   @id @default(uuid())
  role        Role     @relation(fields: [roleId], references: [id])
  roleId      String
  permission  Permission @relation(fields: [permissionId], references: [id])
  permissionId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  roles       RolePermission[]
}

model Project {
  id           String         @id @default(uuid())
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  dueStart     DateTime
  dueEnd       DateTime?
  
  isArchived   Boolean        @default(false)   
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?      
  deletedAt    DateTime?      
  
  status       ProjectStatus   @relation(fields: [projectStatusId], references: [id])
  projectStatusId     String
  timelines    Timeline[]
  tasksStatuses TaskStatus[]
  members      ProjectMember[]
  tasks        Task[]
  tags         ProjectTag[]
  comments     Comment[]
  documents    Document[]

 
}

model ProjectTag {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  tagId       String
  tag         Tag      @relation(fields: [tagId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
}

model ProjectStatus {
  id          String   @id @default(uuid())
  name        String   @unique
  description String? @db.Text
  color       String?
  order       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  projects       Project[]
}

model ProjectMember {
  id              String    @id @default(uuid())
  isActive        Boolean @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? 
  assignedTasks Assignee[]
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  project         Project   @relation(fields: [projectId], references: [id])
  projectId       String
  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id])
  projectRoleId String
  createdTasks Task[] @relation("creator")
  @@unique([userId, projectId])
}

model ProjectRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  members     ProjectMember[]
  projectsRolePermissions       ProjectRolePermission[]
}

model ProjectRolePermission {
  id          String   @id @default(uuid())
  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id])
  projectRoleId String
  projectPermission ProjectPermission @relation(fields: [projectPermissionId], references: [id])
  projectPermissionId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  @@unique([projectRoleId, projectPermissionId])
}
model ProjectPermission {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  projectsRolePermissions     ProjectRolePermission[]
}

model Timeline {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? 

  tasksStatuses       TaskStatus[]
  tasks              Task[]
  project     Project @relation(fields: [projectId], references: [id])
  projectId   String
}

model TaskStatus {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  tasks       Task[]
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  timelineId String?
  timeline   Timeline? @relation(fields: [timelineId], references: [id])
}

model DefaultTaskStatus {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
  createdBy   String?
  createdByUser User?   @relation(fields: [createdBy], references: [id])
}

model TaskPriority {
  id          String   @id @default(uuid())
  name        String   @unique             
  description String?
  color       String?                      
  order       Int                         
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tasks       Task[]
}


model Task {
  id           String       @id @default(uuid())
  title        String
  description  String? @db.Text
  priority     TaskPriority @relation(fields: [priorityId], references: [id])
  priorityId   String
  startDate    DateTime?
  endDate      DateTime?
  dueStart     DateTime
  dueEnd       DateTime
  
  estimatedHours Float?
  actualHours  Float?
  isArchived   Boolean      @default(false)   
  createdAt    DateTime     @default(now())
  createdBy   ProjectMember? @relation( "creator", fields: [createdById], references: [id])
  createdById String?
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?    
  deletedAt    DateTime?    
 

  status       TaskStatus   @relation(fields: [statusId], references: [id])
  statusId     String
  
  project      Project      @relation(fields: [projectId], references: [id])
  projectId    String
  
  timeline     Timeline    @relation(fields: [timelineId], references: [id])
  timelineId   String

  assignees     Assignee[]
  
  parentTask   Task?        @relation("TaskDependency", fields: [parentTaskId], references: [id])
  parentTaskId String?
  subtasks     Task[]       @relation("TaskDependency")
  
  dependencies Task[]       @relation("TaskRelationship")
  dependents   Task[]       @relation("TaskRelationship")
  
  
  comments     Comment[]
  documents    Document[]
 
  taskReviews      TaskReview[]
}

model Assignee {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  memberId      String
  member        ProjectMember     @relation(fields: [memberId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? 
}


model Comment {
  id        String    @id @default(uuid())
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  task      Task?     @relation(fields: [taskId], references: [id])
  taskId    String?
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
}

model Notification {
  id        String    @id @default(uuid())
  title     String
  content   String? @db.Text
  isRead    Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime? 
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 
  projects  ProjectTag[]
  
}

model Document {
  id          String    @id @default(uuid())
  name        String
  filePath    String
  fileType    String
  size        Int
  description String?
  isArchived  Boolean   @default(false)    
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime? 
  deletedAt   DateTime? 
  uploadedBy  User      @relation(fields: [userId], references: [id])
  userId      String
  project     Project?  @relation(fields: [projectId], references: [id])
  projectId   String?
  task        Task?     @relation(fields: [taskId], references: [id])
  taskId      String?
}

