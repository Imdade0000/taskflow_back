// Schéma Prisma avec gestion complète du cycle de vie des données

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  firstname String
  lastname  String
  username  String  @unique
  email     String  @unique
  phone     String? @unique
  password  String

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  creator      User?     @relation("creator", fields: [createdBy], references: [id])
  createdUsers User[]    @relation("creator")
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  refreshTokens    RefreshToken[]
  twoFactorEnabled Boolean        @default(true)
  twoFactorCode    String?
  twoFactorExpiry  DateTime?

  departementId String?
  department    Department? @relation(fields: [departementId], references: [id])

  roleId              String
  role                Role?                @relation(fields: [roleId], references: [id])
  clientProfile       ClientProfile?
  ProjectMembers      ProjectMember[]
  comments            Comment[]
  notifications       Notification[]
  documents           Document[]
  defaultTaskStatuses DefaultTaskStatus[]
  reviews             TaskReview[]
  passwordResetTokens PasswordResetToken[]
}

// Table pour la gestion de notation des tâches
// Un utilisateur peut évaluer plusieurs tâches, et une tâche peut être évaluée par plusieurs utilisateurs
model TaskReview {
  id         String    @id @default(uuid())
  reviewerId String
  reviewer   User      @relation(fields: [reviewerId], references: [id])
  rating     Int
  comment    String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  TaskId     String
  task       Task      @relation(fields: [TaskId], references: [id])
}

// Table de gestion des départements
// Un département peut avoir plusieurs sous-départements et un département parent
// Un utilisateur peut appartenir à plusieurs départements
model Department {
  id             String       @id @default(uuid())
  departmentId   String?
  department     Department?  @relation("AffiliatedDepartments", fields: [departmentId], references: [id])
  subDepartments Department[] @relation("AffiliatedDepartments")
  name           String       @unique
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  users          User[]
}

// Table de gestion des jetons de rafraîchissement
// Un utilisateur peut avoir plusieurs jetons de rafraîchissement
model RefreshToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  token     String   @unique
  expiresAt DateTime
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// Table de gestion des profils clients
// Un utilisateur peut avoir un seul profil client
model ClientProfile {
  id           String    @id @default(uuid())
  clientTicket String    @unique
  company      String?
  industry     String?
  address      String?
  website      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// Table de gestion des rôles et permissions
// Un utilisateur peut avoir plusieurs rôles et permissions
model Role {
  id                String           @id @default(uuid())
  name              String           @unique
  description       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  hasAllPermissions Boolean          @default(false)
  users             User[]
  permissions       RolePermission[]
}

// Table de liaison entre les rôles et les permissions
model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

// Table de gestion des permissions
// Une permission peut être associée à plusieurs rôles
model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  domain      String? // Nouveau champ pour organiser par domaine
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  roles       RolePermission[]
}

// Table de gestion des projets
// Un projet peut avoir plusieurs membres, tâches, commentaires, documents, etc.
model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  dueStart    DateTime
  dueEnd      DateTime?

  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  status          ProjectStatus   @relation(fields: [projectStatusId], references: [id])
  projectStatusId String
  timelines       Timeline[]
  tasksStatuses   TaskStatus[]
  members         ProjectMember[]
  tasks           Task[]
  tags            ProjectTag[]
  comments        Comment[]
  documents       Document[]
}

// Table de liaison entre les projets et les tags
model ProjectTag {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  tagId     String
  tag       Tag       @relation(fields: [tagId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Table de gestion des statuts de projet
// Un projet peut avoir plusieurs statuts
model ProjectStatus {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?   @db.Text
  color       String?
  order       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  projects    Project[]
}

// Table de gestion des membres de projet
// Un membre de projet peut avoir plusieurs tâches assignées, commentaires, documents, etc.
model ProjectMember {
  id            String      @id @default(uuid())
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  assignedTasks Assignee[]
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  project       Project     @relation(fields: [projectId], references: [id])
  projectId     String
  projectRole   ProjectRole @relation(fields: [projectRoleId], references: [id])
  projectRoleId String
  createdTasks  Task[]      @relation("creator")

  @@unique([userId, projectId])
}

// Table de gestion des rôles de projet
// Un projet peut avoir plusieurs rôles et permissions
model ProjectRole {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  description             String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  members                 ProjectMember[]
  projectsRolePermissions ProjectRolePermission[]
}

// Table de liaison entre les rôles de projet et les permissions
// Un rôle de projet peut avoir plusieurs permissions
model ProjectRolePermission {
  id                  String            @id @default(uuid())
  projectRole         ProjectRole       @relation(fields: [projectRoleId], references: [id])
  projectRoleId       String
  projectPermission   ProjectPermission @relation(fields: [projectPermissionId], references: [id])
  projectPermissionId String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@unique([projectRoleId, projectPermissionId])
}

// Table de gestion des permissions de projet
// Une permission de projet peut être associée à plusieurs rôles de projet
model ProjectPermission {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  slug                    String                  @unique
  description             String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  projectsRolePermissions ProjectRolePermission[]
}

// Table de gestion des timelines
// Une timeline peut avoir plusieurs tâches, statuts de tâches, etc.
model Timeline {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tasksStatuses TaskStatus[]
  tasks         Task[]
  project       Project      @relation(fields: [projectId], references: [id])
  projectId     String
}

// Table de gestion des statuts de tâches
// Un statut de tâche peut être associé à plusieurs tâches
model TaskStatus {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  color       String?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tasks       Task[]
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  timelineId  String?
  timeline    Timeline? @relation(fields: [timelineId], references: [id])
}

// Table de gestion des statuts de tâches par défaut
// Un statut de tâche par défaut peut être associé à plusieurs tâches
model DefaultTaskStatus {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  color         String?
  order         Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  createdByUser User?     @relation(fields: [createdBy], references: [id])
}

// Table de gestion des priorités de tâches
// Une priorité de tâche peut être associée à plusieurs tâches
model TaskPriority {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  color       String?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tasks Task[]
}

// Table de gestion des tâches
// Une tâche peut avoir plusieurs membres assignés, commentaires, documents, etc.
// Une tâche peut être associée à plusieurs autres tâches (dépendances, sous-tâches, etc.)
// Une tâche peut être associée à plusieurs statuts de tâches
model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  priority    TaskPriority @relation(fields: [priorityId], references: [id])
  priorityId  String
  startDate   DateTime?
  endDate     DateTime?
  dueStart    DateTime
  dueEnd      DateTime?

  estimatedHours Float?
  actualHours    Float?
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  createdBy      ProjectMember? @relation("creator", fields: [createdById], references: [id])
  createdById    String?
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?

  status   TaskStatus @relation(fields: [statusId], references: [id])
  statusId String

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  timeline   Timeline? @relation(fields: [timelineId], references: [id])
  timelineId String?

  assignees Assignee[]

  parentTask   Task?   @relation("TaskDependency", fields: [parentTaskId], references: [id])
  parentTaskId String?
  subtasks     Task[]  @relation("TaskDependency")

  dependencies Task[] @relation("TaskRelationship")
  dependents   Task[] @relation("TaskRelationship")

  comments  Comment[]
  documents Document[]

  taskReviews TaskReview[]
}

// Table de gestion des personnes assignées aux tâches
// Une tâche peut avoir plusieurs personnes assignées
model Assignee {
  id        String        @id @default(uuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id])
  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
}

// Table de gestion des commentaires
// Un commentaire peut être associé à plusieurs tâches, projets, etc.
model Comment {
  id        String    @id @default(uuid())
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  task      Task?     @relation(fields: [taskId], references: [id])
  taskId    String?
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
}

// Table de gestion des notifications
// Une notification peut être associée à un seul utilisateur

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_COMMENT
  DEADLINE_REMINDER
  PROJECT_UPDATE
}

model Notification {
  id        String    @id @default(uuid())
  title     String
  content   String?   @db.Text
  type      String
  isRead    Boolean   @default(false)
  taskId    String?
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Table de gestion des tags
// Un tag peut être associé à plusieurs projets
model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  projects  ProjectTag[]
}

// Table de gestion des documents
// Un document peut être associé à plusieurs projets, tâches, etc.
model Document {
  id          String    @id @default(uuid())
  name        String
  filePath    String
  fileType    String
  size        Int
  description String?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?
  uploadedBy  User      @relation(fields: [userId], references: [id])
  userId      String
  project     Project?  @relation(fields: [projectId], references: [id])
  projectId   String?
  task        Task?     @relation(fields: [taskId], references: [id])
  taskId      String?
}

